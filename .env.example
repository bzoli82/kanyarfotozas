APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Az SMTP-adatok az admin /admin/settings/critical „E-mail kuldes" szekciojaban
# is beallithatok (titkositva a site_settings-ben); ezek az ertekek fallbackkent
# szolgalnak, amig ott nincs mentve semmi.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Tavoli NAS (SFTP) — teljes felbontasu eredeti + letoltheto media tarolasa
NAS_HOST=
NAS_PORT=22
NAS_USERNAME=
NAS_PASSWORD=
NAS_PRIVATE_KEY=
NAS_PRIVATE_KEY_PASSPHRASE=
NAS_ROOT=/kanyarfotozas

# ── Media tarolo diskek ──────────────────────────────────────────────
# Dev: minden lokalis (public + nas). Eles: R2-re allitva.
#   MEDIA_PUBLIC_DISK=r2_public     (thumbnail / vizjeles elonezet / HLS / hero)
#   MEDIA_ARCHIVE_DISK=r2_private   (feltoltott eredeti + letoltheto JPEG/WebP/MP4)
MEDIA_PUBLIC_DISK=public
MEDIA_ARCHIVE_DISK=nas
# Kezbesitesi gyorsitotar (delivery cache): a megvasarolt fajlok gyors, mindig
# elerheto masolata — a vasarlo-oldali letoltes igy nem fugg az archiv retegtol.
# Alapertelmezetten lokalis disk (a webhoston), a purge parancs takaritja.
MEDIA_DELIVERY_DISK=delivery
MEDIA_DELIVERY_MAX_AGE_HOURS=168

# ── Cloudflare R2 (S3-kompatibilis) ──────────────────────────────────
# Egy account, ket bucket. Az endpoint az account-szintu S3 API URL.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=kanyarfotozas-public
R2_PRIVATE_BUCKET=kanyarfotozas-private
# A publikus bucket sajat domain / R2.dev URL-je (a bongeszo innen tolti a kepeket):
R2_PUBLIC_URL=https://media.example.com

# FFmpeg (EPIC-05 videofeldolgozas) — ha nincs a PATH-on, add meg a teljes utvonalat
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Video-mod: `pipeline` (alap) = szerver-oldali FFmpeg kodolas; `preprocessed` =
# nincs szerver-oldali kodolas, a fotos elore feltolti a fajl-harmast:
#   klip.mp4  +  klip_lores.mp4 (kis felbontasu elonezet)  +  klip.jpg (poszter, opcionalis)
MEDIA_VIDEO_MODE=pipeline

# ── Fizetes (EPIC-07) ────────────────────────────────────────────────
# A fizetesi kulcsok az admin /admin/settings/critical oldalon is beallithatok
# (titkositva a site_settings-ben) — akkor ezeket az .env ertekeket feluliras nelkul hagyd.
# Alapertelmezett szolgaltato, ha a kosar nem kuld explicit valasztast:
PAYMENT_PROVIDER_DEFAULT=stripe

# Stripe — sandbox/teszt kulcsok (https://dashboard.stripe.com/test/apikeys)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# SimplePay (OTP Mobil) v2 — a merchant + secret key a SimplePay
# kereskedoi fiokbol (HUF penznemhez). SANDBOX=true a tesztfiokhoz.
# IPN URL a SimplePay adminban: {APP_URL}/api/simplepay/ipn
SIMPLEPAY_MERCHANT=
SIMPLEPAY_SECRET_KEY=
SIMPLEPAY_SANDBOX=true

# Barion Smart Gateway v2 — a POSKey a Barion kereskedoi fiokbol (Shops),
# a PAYEE a Barion fiok e-mail cime (a jovairas celja). SANDBOX=true a
# https://sandbox.barion.com tesztfiokhoz. Callback URL a Barion shopnal:
# {APP_URL}/api/barion/callback
BARION_POS_KEY=
BARION_PAYEE=
BARION_SANDBOX=true

# ── Hibakovetes + mentes (monitoring) ────────────────────────────────
# A hiba-webhook URL + az e-mail ertesites az admin /admin/settings/critical
# oldalon is beallithato (a webhook titkositva a site_settings-ben).
ERROR_COOLDOWN_MINUTES=30
# Napi adatbazis-mentes: a pg_dump eleresi utja (ha nincs a PATH-on, teljes ut),
# a cel-disk (filesystems.php: local / nas / r2_private), es a megtartott mentesek szama.
PG_DUMP_BINARY=pg_dump
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_KEEP=14

# ── Publikus urlap-vedelem (App\Support\FormGuard) ───────────────────
# Proof-of-work nehezseg bitekben (17 ~ 130k SHA-256 hash a bongeszoben,
# lathatatlan; magasabb = tobb vedelem, de lassabb old gepeknen).
FORMGUARD_POW_BITS=17
FORMGUARD_MIN_FILL_SECONDS=3

# hCaptcha a Kapcsolat urlaphoz — adminbol is bekapcsolhato/beallithato
# (/admin/settings/critical). Teszt-kulcsparral mindig sikeres:
#   site: 10000000-ffff-ffff-ffff-000000000001
#   secret: 0x0000000000000000000000000000000000000000
HCAPTCHA_ENABLED=false
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

VITE_APP_NAME="${APP_NAME}"
